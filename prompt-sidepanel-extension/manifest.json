{
  "manifest_version": 3,
  "name": "QuickPrompt SidePanel - 定番プロンプト送信ツール",
  "version": "1.0.0",
  "description": "ChatGPT、Claude、Geminiなどの入力欄に、よく使う定番プロンプトをワンクリックでさっと挿入・送信できるサイドパネル拡張機能",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "QuickPrompt パネルを開く"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
